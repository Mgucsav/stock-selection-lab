# Backend (FastAPI) ayarları — SSL_ öneki: Stock Selection Lab
# Veri sağlayıcı: yahoo (canlı, gecikmeli) | fake (test)
SSL_DATA_PROVIDER=yahoo
SSL_BENCHMARK_SYMBOL=XU100.IS
SSL_LOOKBACK_YEARS=3
SSL_BATCH_SIZE=25
SSL_MAX_RETRIES=3
SSL_STALE_DAYS=7
# İkincil doğrulama kaynağı: isyatirim | none
SSL_SECONDARY_PROVIDER=isyatirim
SSL_VERIFICATION_DAYS=15
SSL_VERIFICATION_TOLERANCE=0.002
# Günlük veri bu kadar saatten eskiyse (ya da demo modundaysa) backend açılışta/saat başı kendisi yeniler; 0 = kapalı
SSL_AUTO_REFRESH_HOURS=20
# Fiyat anlık görüntüsünün arka planda yenilenme sıklığı (saniye); 0 = kapalı
SSL_QUOTE_POLL_SECONDS=45
SSL_QUOTE_IDLE_POLL_SECONDS=600

# Yerel MVP: SQLite + Parquet cache. Supabase geçişinde PostgreSQL URL'si verilir:
# SSL_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
SSL_DATABASE_URL=sqlite:///state/stock_selection.db
SSL_CACHE_DIR=data/cache
# Fiyat deposu: auto | sql (veritabanı tabloları) | parquet (pyarrow gerekir)
SSL_PRICE_STORE=auto
SSL_UNIVERSE_CSV=config/bist100_symbols.csv
SSL_PROFILES_JSON=config/profiles.json

# Frontend adresleri (CORS)
SSL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Bulutta Vercel önizleme adresleri için: SSL_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Frontend (apps/web/.env.local) için:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
